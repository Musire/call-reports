{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prod": "rm -rf .next && npm run build && npm run start",
    "dev:clear": "cls && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rd /s /q .next && npm run dev:clear",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck",
    "build:turbo": "next build --turbo",
    "analyze": "ANALYZE=true npm run build",
    "nuke": "rd /s /q .next node_modules && del /f /q package-lock.json && npm install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "lucide": "^1.7.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
